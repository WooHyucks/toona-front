# Local FastAPI (server-side / production client).
NEXT_PUBLIC_TOONA_API_BASE=http://127.0.0.1:8000

# Phone on the same Wi-Fi: run `npm run dev -- --hostname 0.0.0.0`.
# The browser uses same-origin `/api` and `/content`; Next rewrites to FastAPI.
# Optional override if you need the phone to call FastAPI directly:
# NEXT_PUBLIC_TOONA_API_BASE=http://YOUR_MAC_LAN_IP:8000

# Production (Cloud Run)
# NEXT_PUBLIC_TOONA_API_BASE=https://toona-api-610048355251.asia-northeast3.run.app

# Canonical / Open Graph absolute URLs (no trailing slash). Required for production.
# Example: https://toona.kr
NEXT_PUBLIC_SITE_URL=

# Amplitude Browser SDK (API Key only — do not use Secret Key in the client)
NEXT_PUBLIC_AMPLITUDE_API_KEY=
