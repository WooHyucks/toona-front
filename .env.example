# Local FastAPI
NEXT_PUBLIC_TOONA_API_BASE=http://localhost:8000

# Production (Cloud Run)
# NEXT_PUBLIC_TOONA_API_BASE=https://toona-api-610048355251.asia-northeast3.run.app

# Canonical / Open Graph absolute URLs (no trailing slash). Required for production.
# Example: https://toona.kr
NEXT_PUBLIC_SITE_URL=

# Amplitude Browser SDK (API Key only — do not use Secret Key in the client)
NEXT_PUBLIC_AMPLITUDE_API_KEY=
